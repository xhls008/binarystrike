{
  "name": "binstrike",
  "displayName": "BinStrike",
  "description": "BinStrike V2 terminal integration for VS Code",
  "version": "2.0.15",
  "publisher": "binarystrike",
  "repository": {
    "type": "git",
    "url": "https://github.com/xhls008/binarystrike"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "binstrike.openTerminal",
        "title": "BinStrike: Open Terminal"
      },
      {
        "command": "binstrike.openNewTerminal",
        "title": "BinStrike: New Terminal"
      },
      {
        "command": "binstrike.copyReference",
        "title": "BinStrike: Copy File Reference"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "binstrike.openTerminal",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "binstrike.copyReference",
          "when": "resourceScheme == file"
        }
      ]
    },
    "keybindings": [
      {
        "command": "binstrike.openTerminal",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "binstrike.openNewTerminal",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      }
    ],
    "configuration": {
      "title": "BinStrike",
      "properties": {
        "binstrike.cliPath": {
          "type": "string",
          "default": "binstrike",
          "scope": "machine",
          "description": "CLI executable (not a shell command). Set an absolute path if it is not on PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "typecheck": "tsc --noEmit",
    "vsix": "bunx --bun @vscode/vsce package --no-dependencies --out dist/binstrike.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Launching the CLI requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  }
}
